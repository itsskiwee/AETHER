{
  "name": "aether-cloudflare-hosting",
  "private": true,
  "scripts": {
    "build:cloudflare": "npm --prefix frontend run build && python scripts/export_cloudflare_snapshot.py",
    "cloudflare:build": "python scripts/build_cloudflare.py",
    "deploy:cloudflare": "wrangler deploy --config wrangler.jsonc",
    "dev:cloudflare": "wrangler dev --config wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
