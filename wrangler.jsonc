{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aether-replay-hosted",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "AetherReplayContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AETHER_REPLAY",
        "class_name": "AetherReplayContainer"
      }
    ]
  },
  "exports": {
    "AetherReplayContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
