# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Every variable is optional: offline tests and the synthetic fixtures need none of them.

# NASA Earthdata (EMIT V002 downloads, ING-02). Preferred: `earthaccess login`, which writes
# ~/.netrc. Otherwise set a user token from https://urs.earthdata.nasa.gov/ here.
EARTHDATA_TOKEN=

# Carbon Mapper Data Platform API (optional P1 adapter, ING-06). Record the Terms of Use version in
# DATA_LICENSES.md before storing any record.
CARBON_MAPPER_API_TOKEN=

# Copernicus Climate Data Store (ERA5 checks, SIM-02). Format "<uid>:<api-key>" or as documented
# by the cdsapi version in use.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# P1 only: PostGIS connection for the research deployment.
DATABASE_URL=
